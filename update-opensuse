#!/usr/bin/env bash
# Update openSUSE Tumbleweed and MicroOS systems.
# Supports regular and transactional installations.

set -Eeuo pipefail

usage() {
    echo "Usage: update-opensuse {check|upgrade}"
    echo ""
    echo "Options:"
    echo "  check   : Check system and Flatpak updates without installing."
    echo "  upgrade : Install/stage updates and prompt to reboot."
    exit 1
}

error() {
    echo "Error: $*" >&2
    exit 1
}

info() {
    echo ""
    echo "==> $*"
}

# Validate arguments.
if [[ $# -ne 1 ]]; then
    usage
fi

COMMAND="$1"

case "$COMMAND" in
    check|upgrade) ;;
    *) usage ;;
esac

# Require root privileges.
if [[ "$(id -u)" -ne 0 ]]; then
    error "Run as root: sudo /usr/local/bin/update-opensuse $COMMAND"
fi

# Identify distribution.
if [[ ! -f /etc/os-release ]]; then
    error "Cannot identify distribution."
fi

source /etc/os-release

case "${ID:-}" in
    opensuse-tumbleweed)
        DISTRO="Tumbleweed"
        ;;
    opensuse-microos)
        DISTRO="MicroOS"
        ;;
    *)
        error "Unsupported distribution: ${PRETTY_NAME:-Unknown}"
        ;;
esac

# Detect transactional systems.
IS_TRANSACTIONAL=false

if [[ "$DISTRO" == "MicroOS" ]]; then
    IS_TRANSACTIONAL=true
elif command -v transactional-update >/dev/null 2>&1; then
    # Also support transactional Tumbleweed installations.
    if findmnt -no OPTIONS / | tr ',' '\n' | grep -qx ro; then
        IS_TRANSACTIONAL=true
    fi
fi

if [[ "$IS_TRANSACTIONAL" == true ]]; then
    if ! command -v transactional-update >/dev/null 2>&1; then
        error "transactional-update is not installed."
    fi
fi

if ! command -v zypper >/dev/null 2>&1; then
    error "zypper is not installed."
fi

# Identify the user who invoked sudo.
FLATPAK_USER="${SUDO_USER:-}"

if [[ "$FLATPAK_USER" == "root" ]]; then
    FLATPAK_USER=""
fi

# Run Flatpak commands for the invoking user.
user_flatpak() {
    runuser -u "$FLATPAK_USER" -- flatpak --user "$@"
}

# Check both Flatpak installation scopes.
check_flatpaks() {
    if ! command -v flatpak >/dev/null 2>&1; then
        return 0
    fi

    info "Checking system-wide Flatpak updates..."
    local sys_updates
    sys_updates=$(flatpak --system remote-ls --updates)
    if [[ -n "$sys_updates" ]]; then
        echo "$sys_updates"
    else
        echo "No system-wide Flatpak updates available."
    fi

    if [[ -n "$FLATPAK_USER" ]]; then
        info "Checking Flatpak updates for $FLATPAK_USER..."
        local user_updates
        user_updates=$(user_flatpak remote-ls --updates)
        if [[ -n "$user_updates" ]]; then
            echo "$user_updates"
        else
            echo "No user Flatpak updates available."
        fi
    fi
}

# Upgrade both Flatpak installation scopes.
upgrade_flatpaks() {
    if ! command -v flatpak >/dev/null 2>&1; then
        return 0
    fi

    info "Updating system-wide Flatpaks..."
    flatpak --system update -y

    if [[ -n "$FLATPAK_USER" ]]; then
        info "Updating Flatpaks for $FLATPAK_USER..."
        user_flatpak update -y
    fi
}

# Check system updates without modifying installed packages.
check_system() {
    info "Refreshing repository metadata..."
    zypper refresh

    info "Checking distribution updates..."
    local rc=0
    if ! zypper --non-interactive dup --dry-run --details --auto-agree-with-licenses; then
        rc=$?
    fi

    # 0 = no updates, 100 = updates available (ZYPPER_EXIT_INF_UPDATE_NEEDED)
    if [[ "$rc" -ne 0 && "$rc" -ne 100 ]]; then
        error "zypper dry-run failed with exit code $rc."
    fi
}

# Upgrade the host.
upgrade_system() {
    if command -v dkms >/dev/null 2>&1; then

        if [[ "$IS_TRANSACTIONAL" == true ]]; then
            info "Updating transactional system with DKMS..."

            if ! transactional-update --continue run bash -c '
                set -Eeuo pipefail

                trap '\''rc=$?; echo >&2; echo "TRANSACTION ERROR: Command failed at line ${LINENO}: ${BASH_COMMAND} (exit code: ${rc})" >&2; exit "$rc"'\'' ERR

                echo ""
                echo "==> Refreshing repository metadata..."
                zypper refresh

                echo ""
                echo "==> Upgrading the distribution..."
                zypper dup --auto-agree-with-licenses

                echo ""
                echo "==> Detecting target kernel..."

                KERNEL_VERSION=$(
                    find /usr/lib/modules \
                        -mindepth 1 \
                        -maxdepth 1 \
                        -type d \
                        -printf "%f\n" |
                    sort -V |
                    tail -n 1
                )

                if [[ -z "$KERNEL_VERSION" ]]; then
                    echo "ERROR: Could not determine the target kernel version." >&2
                    exit 1
                fi

                echo "Target kernel: $KERNEL_VERSION"

                echo ""
                echo "==> Checking kernel development files..."

                if [[ ! -e "/usr/lib/modules/$KERNEL_VERSION/build" ]]; then
                    echo "ERROR: Kernel development files are missing for $KERNEL_VERSION." >&2
                    exit 1
                fi

                echo ""
                echo "==> Rebuilding DKMS modules..."

                dkms autoinstall --kernelver "$KERNEL_VERSION"

                echo ""
                echo "==> DKMS status..."
                dkms status

                echo ""
                echo "==> DKMS rebuild completed successfully."
            '; then
                error "Transactional upgrade or DKMS rebuild failed. Review the error output above."
            fi

        else
            info "Updating regular Tumbleweed with DKMS..."

            zypper refresh
            zypper dup --auto-agree-with-licenses

            info "Detecting target kernel..."

            KERNEL_VERSION=$(
                find /usr/lib/modules \
                    -mindepth 1 \
                    -maxdepth 1 \
                    -type d \
                    -printf "%f\n" |
                sort -V |
                tail -n 1
            )

            if [[ -z "$KERNEL_VERSION" ]]; then
                error "Could not determine the target kernel version."
            fi

            echo "Target kernel: $KERNEL_VERSION"

            info "Checking kernel development files..."

            if [[ ! -e "/usr/lib/modules/$KERNEL_VERSION/build" ]]; then
                error "Kernel development files are missing for $KERNEL_VERSION."
            fi

            info "Rebuilding DKMS modules..."

            dkms autoinstall --kernelver "$KERNEL_VERSION"

            info "DKMS status..."
            dkms status

            info "DKMS rebuild completed successfully."
        fi

    else
        # Original upgrade logic — unchanged when DKMS is not installed.
        if [[ "$IS_TRANSACTIONAL" == true ]]; then
            info "Updating transactional system..."

            # Continue from the default snapshot so already-staged
            # changes are retained if a reboot is still pending.
            transactional-update --continue -i dup
        else
            info "Updating regular Tumbleweed..."

            zypper refresh
            zypper dup --auto-agree-with-licenses
        fi
    fi
}

# Print detected configuration.
echo "Distribution : $DISTRO"
echo "Transactional: $IS_TRANSACTIONAL"
echo "Mode         : $COMMAND"

# CHECK
if [[ "$COMMAND" == "check" ]]; then
    check_system
    check_flatpaks

    info "Update check complete."
    if [[ "$DISTRO" == "MicroOS" ]]; then
        # The Makefile installs this sudo alias in the invoking user's ~/.alias.
        echo "Run 'update-opensuse upgrade' to upgrade."
    else
        echo "Run 'sudo /usr/local/bin/update-opensuse upgrade' to upgrade."
    fi
    exit 0
fi

# UPGRADE
upgrade_system

info "System upgrade completed successfully."

upgrade_flatpaks

info "Update process completed."

if [[ "$IS_TRANSACTIONAL" == true ]]; then
    echo "System changes will become active after reboot."
else
    echo "System packages have been updated."
    echo "A reboot is recommended to load the latest kernel and services."
fi

echo ""
read -r -p "Do you want to reboot now? [y/N] " response

if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    info "Rebooting..."
    systemctl reboot
else
    echo "Reboot skipped."
fi